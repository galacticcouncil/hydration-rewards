# Copy to .env (which is not checked in). The snapshotter and the runner read it when they start;
# a variable already set in the shell wins over the file.

# Archive RPC used for snapshots and deploys (the public endpoint is the default in config/mainnet.json)
RPC_HYDRATION=https://rpc.hydradx.cloud

# The runner (src/bot.ts)
# Date of the very first epoch, e.g. 2027-01-15. Required.
FIRST_EPOCH=
# Optional: program file, data folder and seconds between passes. These are the defaults.
# PROGRAM=programs/htoken-no-hollar-borrowers.yaml
# DATA_DIR=data
# BOT_INTERVAL_SECONDS=60

# Deploying the distributor (sh/migrate-distributor.sh); see README.md. Its other settings are in
# migrations/envs/<env>/distributor.env.
# The deployer's private key, with an EVMAccounts.ContractDeployer slot on Hydration. Only on the
# machine that deploys, and never committed.
PK_HYDRATION=

# Posting roots (README, "Posting roots"). Both or neither: with both, the runner posts each root
# and accepts it after the timelock. The key is one of its own, holding only a little WETH for gas.
# PRIVKEY=
# URD_ADDRESS=
# The genesis hash the node's chain must have (Hydration's here); Lark has the same chain id.
# URD_GENESIS=0xafdc188f45c71dacbaa0b62e16a91f726c7b8699a9748cdf715459de6b7f366d
