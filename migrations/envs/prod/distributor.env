# An RPC_HYDRATION already set in the shell or in .env is kept.
RPC_HYDRATION=${RPC_HYDRATION:-https://rpc.hydradx.cloud}
# Hydration's genesis hash. The node must serve this chain: Lark, the testnet forked from it, has
# the same chain id, and an RPC_HYDRATION left over from a test run would otherwise deploy there.
URD_GENESIS=0xafdc188f45c71dacbaa0b62e16a91f726c7b8699a9748cdf715459de6b7f366d

# The owner of the distributor: the emergency admin, which the Technical Committee acts as by motion
# (dispatcher.dispatchAsEmergencyAdmin). Required.
URD_OWNER=0xaa7e0000000000000000000000000000000aa7e1
# Empty: one transaction, the emergency admin owns the distributor from its first block and adds the
# root-posting address itself with setRootUpdater (by Technical Committee motion or Root). With that
# address here (0x..., never a private key) the deployer adds it and hands the distributor to the
# emergency admin, and owns it for those two transactions first (README, "Deploying the distributor").
URD_UPDATER=
# Seconds between a root being posted and becoming claimable. Shorter than a day.
URD_TIMELOCK=43200
